{
  "name": "beekeeper-clone",
  "version": "0.1.0",
  "description": "A cross-platform SQL client for Microsoft SQL Server, built with Electron and Vue 3.",
  "main": "./out/main/index.js",
  "author": "beekeeper-clone",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "build:unpack": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "scripts/e2e.sh all",
    "test:e2e:smoke": "scripts/e2e.sh smoke",
    "test:e2e:workspace": "scripts/e2e.sh workspace",
    "test:e2e:editing": "scripts/e2e.sh editing",
    "test:e2e:table-ui": "scripts/e2e.sh table-ui",
    "testenv:up": "scripts/test-env.sh up",
    "testenv:down": "scripts/test-env.sh down",
    "testenv:status": "scripts/test-env.sh status",
    "test:e2e:ssm": "scripts/e2e.sh ssm-form"
  },
  "dependencies": {
    "mssql": "^12.7.0",
    "sql-formatter": "^15.8.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.15.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pinia": "^4.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "codemirror": "^6.0.2",
    "@codemirror/autocomplete": "^6.19.0",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.1",
    "@codemirror/theme-one-dark": "^6.1.3"
  }
}
